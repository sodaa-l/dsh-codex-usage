{
  "name": "dsh-codex-usage",
  "version": "0.1.0",
  "description": "Shows Codex five-hour and weekly usage in the sidebar and footer.",
  "icon": "./icon.svg",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./oauth": "./src/oauth.js",
    "./shared": "./src/shared.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/oauth.js",
    "src/shared.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "assets/codex-usage.png",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
